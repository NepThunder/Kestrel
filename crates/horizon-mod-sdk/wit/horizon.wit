/// The contract between Horizon and its mods (docs/mods.md).
///
/// A mod is a WebAssembly component targeting the `mod` world. Each imported
/// interface but `log` is a capability: the mod's manifest lists the ones it
/// uses, the player sees them before turning the mod on, and the game refuses
/// a component that imports one its manifest does not declare.
package horizon:mods@0.1.0;

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    /// One line in the game's log as `[mod <id>] message`, at that level.
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player, the world clock and the block
/// the player looks at. API 18 adds the player themselves: their active
/// effects with the ticks left on them, their movement state and the
/// mount they ride, and the sprint and sneak toggle options a mod may
/// set (the game's own Options, changed the way the options page
/// changes them — nothing here forces the player to move).
interface game {
    record player {
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
        /// 0 to 20, as the hunger bar.
        food: u32,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    /// None on the title screen.
    get-clock: func() -> option<clock>;
    /// A block along the player's view.
    record hit {
        /// The block hit.
        block-x: s32,
        block-y: s32,
        block-z: s32,
        /// The point on its face where the view meets it.
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:stone`, ...
        block: string,
    }
    /// The first block along the player's view (fluids pass), up to
    /// `distance` blocks (at most 1024; past the loaded chunks, across the
    /// distant terrain when LOD Distance is on), as of this tick. None when
    /// nothing is hit, and on the title screen.
    raycast: func(distance: f32) -> option<hit>;
    /// One of the local player's active status effects (API 18).
    record effect {
        /// `minecraft:speed`, `minecraft:poison`, ...
        id: string,
        /// 0 is level I, 1 is level II, as vanilla counts.
        amplifier: u32,
        /// Ticks left, counted down by the client as the game does;
        /// -1 is infinite (a beacon's renewal, a toggled conduit).
        duration: s32,
        /// From a beacon or a conduit: it refreshes while the player
        /// stays in range, and shows faded in the inventory.
        ambient: bool,
        /// The effect throws off particles (a potion's own do; an
        /// ambient beacon effect's are quieter, and one applied with
        /// particles off shows none).
        show-particles: bool,
        /// The effect's icon shows in the HUD. The client always
        /// shows the local player's effect icons today, so this is
        /// always true; the field is the shape's room for a client
        /// that learns to hide one.
        show-icon: bool,
    }
    /// The local player's active effects (API 18), in the game's own
    /// order, as of this tick. An effect queued behind a stronger one
    /// of its kind is not active and not listed; it appears when the
    /// stronger one ends. Empty on the title screen.
    get-effects: func() -> list<effect>;
    /// The living mount the local player rides (API 18).
    record mount {
        /// The entity id, the same id `entity.entities` lists it by.
        id: u32,
        /// `minecraft:horse`, `minecraft:pig`, ...
        kind: string,
        /// Hit points as vanilla counts them.
        health: f32,
        /// The mount kind's maximum.
        max-health: f32,
    }
    /// The local player themselves (API 18): how they move, what
    /// they ride, and the two movement toggle options.
    record self-state {
        /// Sprinting now.
        sprinting: bool,
        /// Sneaking now: the sneak key held or toggled, or a forced
        /// crouch under a low ceiling.
        sneaking: bool,
        /// Flying on the abilities (creative, spectator).
        flying: bool,
        /// Gliding on an elytra: not `flying`, the fall flight the
        /// game tracks separately.
        gliding: bool,
        /// The mount ridden now; none on foot. A boat or a minecart
        /// is not a living mount and reads as none in v1.
        mount: option<mount>,
        /// The Toggle Sprint option is on: the sprint key latches
        /// instead of holding.
        sprint-toggled: bool,
        /// The Toggle Crouch option is on: the sneak key latches.
        sneak-toggled: bool,
    }
    /// The local player's own state (API 18), as of this tick.
    /// None on the title screen.
    get-self-state: func() -> option<self-state>;
    /// Sets the Toggle Sprint / Toggle Crouch options (API 18), the
    /// game's own settings: a `some` sets that option, a `none`
    /// leaves it. They are saved to options.txt, as a change on the
    /// options page is. Only the option changes, never the movement:
    /// a sprint the key already latched stays latched until the key
    /// is next pressed, exactly as when the player flips the option
    /// by hand, and nothing here makes the player sprint, sneak or
    /// fly who isn't.
    set-movement-toggles: func(sprint: option<bool>, sneak: option<bool>);
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: string);
}

/// Capability `hud`: one panel of text lines per mod, drawn by the game
/// every frame until the mod changes or clears it (no call per frame).
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        /// Plain text, up to 256 characters.
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    /// Replaces the mod's panel: up to 16 lines in that corner of the screen.
    set-panel: func(corner: corner, lines: list<line>);
    /// Removes the mod's panel.
    clear: func();
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd
/// (docs/mods.md). Keys are `[a-z0-9_.-]{1,64}`, one path segment.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
}

/// Capability `command`: vanilla commands run as the player, with the
/// player's permissions, after the hook call returns (8 per call). A mod's
/// own commands are not run this way.
interface command {
    /// `line` without its slash; its feedback goes to the chat as if typed.
    run: func(line: string);
    /// `lines` (each without its slash, at most 256 a call) as `run` does,
    /// but with nothing in the chat: no feedback and no failure. In single
    /// player and on Horizon's servers, each runs exactly as the player
    /// typing it would (the same rights), in order, 64 a tick, and the
    /// server logs one line a batch; one that carries a chat message (`say`,
    /// `msg`) is refused. On any other server they go as chat commands, and
    /// there their feedback shows: a mod running many should say so.
    run-quiet: func(lines: list<string>);
}

/// Capability `ui`: widgets the game draws with its own menus' widgets, for
/// a screen the mod owns and a settings page in Options > Mods. Layout and
/// drawing are the game's: a mod says what its widgets hold, never where
/// they sit or how they look, and the game clips everything it is handed.
interface ui {
    /// A line of text.
    record text-widget {
        /// The mod's own name for the widget; `ui-events` calls echo it.
        id: u32,
        /// Up to 256 characters.
        text: string,
        /// 0xRRGGBB; 0 is the menus' white.
        color: u32,
    }
    /// An item's icon and a name beside it, as recipe viewers show them.
    record item-widget {
        /// The mod's own name for the widget.
        id: u32,
        /// `minecraft:diamond`, `<mod>:<path>`; an unknown id draws a "?".
        item: string,
        /// The name shown beside the icon (empty: the item's own).
        name: string,
    }
    /// Rows the player picks one of, as an options page lists choices: a
    /// pick is `ui-events::select`, `selected` is the row to mark now.
    record list-widget {
        /// The mod's own name for the widget; `ui-events::select` echoes it.
        id: u32,
        /// The rows' texts, at most 512, each up to 256 characters.
        rows: list<string>,
        /// The row to mark as the current choice, if any.
        selected: option<u32>,
    }
    /// A thing on a mod's screen or settings page.
    /// A button as the options pages have them (200 × 20): a click is
    /// `ui-events::select(id, 0)`. Mods cycle its label for a choice
    /// ("Corner: Top Left").
    record button-widget {
        /// The mod's own name for the widget.
        id: u32,
        /// Up to 256 characters.
        label: string,
    }
    variant widget {
        /// Text the player reads.
        text(text-widget),
        /// A button.
        button(button-widget),
        /// An item's icon and name.
        item(item-widget),
        /// Rows the player picks from.
        %list(list-widget),
    }
    /// A screen the mod owns: a title over widgets stacked down the middle,
    /// the Done button the game adds, and Esc to leave it.
    record screen {
        /// Its title, up to 256 characters.
        title: string,
        /// Its widgets, in order, at most 64.
        widgets: list<widget>,
    }
    /// Show `screen` over the game; a second call while it is open replaces
    /// it. Only the last call of one hook counts.
    open-screen: func(screen: screen);
    /// Close the mod's screen when it is open (the mod hears no `closed`
    /// for this: it was its own doing).
    close-screen: func();
    /// The mod's page in Options > Mods, reached from a settings button on
    /// its row: the widgets it shows, an empty list for no page. The player
    /// opening the page is `ui-events::settings-opened`: push fresh widgets
    /// then; later calls update the page while it shows.
    set-settings: func(widgets: list<widget>);
}

/// What the game calls on a mod that shows widgets (capability `ui`):
/// what the player did with them.
interface ui-events {
    /// A row of one of the mod's `list` widgets was picked: the widget's
    /// `id` and the row, on the screen or the settings page that showed it.
    select: func(id: u32, row: u32);
    /// The player left the mod's screen (Esc or Done); not for a screen the
    /// mod closed itself or one that went away with the mod.
    closed: func();
    /// The player opened the mod's settings page in Options > Mods: call
    /// `ui::set-settings` now to fill it with fresh widgets.
    settings-opened: func();
}

/// Capability `input` (experimental: the manifest needs
/// `experimental = ["input"]`): the use button on items the mod claims, and
/// the mod's own keys. Events wait for `poll`, at most 256.
interface input {
    /// The main hand's stack.
    record held-item {
        /// `minecraft:spyglass`, `<mod>:<path>`.
        id: string,
        count: u32,
        /// The hotbar slot, 0 to 8.
        slot: u32,
    }
    record item-use {
        item: held-item,
        /// Game ticks the button was held (0 on `use-start`).
        ticks: u32,
    }
    variant event {
        /// The use button went down with a claimed item in the main hand.
        /// The game does nothing else with the click: no placing, no eating,
        /// no swing.
        use-start(item-use),
        /// It came up again, or the item left the hand, or a screen opened.
        use-stop(item-use),
        /// A key `register-key` named went down or up while playing (no
        /// screen open). The game's own mapping on that key still runs. A
        /// screen opening lets every held key up.
        key-down(string),
        key-up(string),
        /// Mouse wheel steps while the mod holds the wheel (`claim-wheel`):
        /// positive away from the player, as the hotbar reads them.
        wheel(f32),
    }
    /// The items whose use the mod handles instead of the game, by id (at
    /// most 64). Replaces the previous list.
    claim-items: func(ids: list<string>);
    /// A key of the mod's: `name` comes back in `key-down` and `key-up`,
    /// `label` says what it does, `key` is the key as options.txt writes
    /// it (`key.keyboard.r`), the default: the player can bind another
    /// one on the mod's page in Options > Mods, and that one wins. At most
    /// 32; an unknown key is an error.
    register-key: func(name: string, label: string, key: string) -> result<_, string>;
    /// The main hand's stack, as of this tick; none when it is empty.
    held: func() -> option<held-item>;
    /// The events since the last call, oldest first.
    poll: func() -> list<event>;
    /// Takes the mouse wheel while playing (true) or gives it back: while
    /// taken, its steps are the mod's `wheel` events and the hotbar doesn't
    /// move. The game gives it back when the mod stops.
    claim-wheel: func(on: bool);
    /// A mapping as the player has bound it.
    record mapping-state {
        /// The bound key's name as Controls shows it: `W`, `Space`, `LMB`.
        label: string,
        /// Held down now (as of this frame for a mod with a `frame` hook,
        /// else this tick).
        down: bool,
    }
    /// A movement or click mapping as the player has bound it: `key.forward`,
    /// `key.left`, `key.back`, `key.right`, `key.jump`, `key.sneak`,
    /// `key.sprint`, `key.attack`, `key.use`, or `key.hotbar.1` to
    /// `key.hotbar.9`. None for another name. A mapping is a read window:
    /// the game's own action on the key still runs — pressing a hotbar
    /// key still selects its slot.
    mapping: func(name: string) -> option<mapping-state>;
    /// Clicks of the attack and use buttons in the last second.
    clicks-per-second: func() -> tuple<u32, u32>;
    /// Milliseconds since the player's last input — a key, a click,
    /// mouse or touch movement, a gamepad or touch-control action —
    /// as the game's own inactivity tracker measures it (the same
    /// clock the game's idle framerate limit reads). 0 at the moment
    /// of input. Before the first snapshot in a world it reads as
    /// the time since the world was entered, as the game seeds it.
    last-input-ms: func() -> u64;
}

/// Capability `render` (experimental: the manifest needs
/// `experimental = ["render"]`): shapes the game draws for the mod with its
/// own renderer, kept until the mod replaces them (no call per frame). A mod
/// never supplies shader code.
interface render {
    /// A corner of the screen, as `hud`'s panels use them.
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    /// A rectangle in GUI pixels: the top left corner and the size.
    record rect {
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }
    /// A point in GUI pixels from the screen's top left.
    record point {
        x: f32,
        y: f32,
    }
    record fill-shape {
        rect: rect,
        /// 0xAARRGGBB.
        color: u32,
    }
    /// Any four-cornered shape (a wheel's segment, an arrow): the corners
    /// in order round it.
    record quad-shape {
        corners: tuple<point, point, point, point>,
        /// 0xAARRGGBB.
        color: u32,
    }
    record sprite-shape {
        /// One of the game's GUI sprites, as `gui/sprites/` names them
        /// (`hud/heart/full`, `widget/button`), the resource packs' versions
        /// included, drawn over `rect` as vanilla draws it: nine-sliced when
        /// its `gui.scaling` says so (`tooltip/frame`, `widget/button`: the
        /// borders keep their size), stretched otherwise. An unknown one
        /// draws nothing.
        sprite: string,
        rect: rect,
        /// A tint, 0xAARRGGBB: 0xFFFFFFFF draws it as it is.
        color: u32,
    }
    record item-shape {
        /// `minecraft:diamond`, `<mod>:<path>`; an unknown one draws nothing.
        item: string,
        /// The icon's top left.
        at: point,
        /// 1.0 is the hotbar's 16 × 16.
        scale: f32,
    }
    record text-shape {
        /// Up to 256 characters, one line.
        text: string,
        at: point,
        /// 0xRRGGBB, as `hud`'s lines.
        color: u32,
        /// Centred on `at.x` instead of starting there.
        centered: bool,
        shadow: bool,
    }
    variant shape {
        fill(fill-shape),
        quad(quad-shape),
        sprite(sprite-shape),
        item(item-shape),
        text(text-shape),
    }
    /// Replaces the mod's HUD shapes: up to 1024, drawn every frame in
    /// order over the HUD (after the hotbar, under chat and screens), hidden
    /// with the HUD (F1). An empty list removes them.
    set-hud: func(shapes: list<shape>);
    /// The screen's size in GUI pixels (width, height), as of this tick.
    gui-size: func() -> tuple<f32, f32>;
    /// Shakes the camera: a jolt of `strength` (0 to 1, 1 the hardest) that
    /// fades out over `seconds` (at most 10). Jolts add up to 1. The view
    /// turns, the player doesn't, and the player's Distortion Effects option
    /// scales it (0 turns it off).
    shake: func(strength: f32, seconds: f32);
    /// Replaces the mod's corner panel: shapes in GUI pixels from the top
    /// left of a `width` × `height` box that the game places in `corner`,
    /// stacked with the game's overlays and the other mods' panels (under
    /// the status effects at the top right), as `hud`'s panels are.
    set-corner: func(corner: corner, width: f32, height: f32, shapes: list<shape>);
    /// Removes the mod's corner panel.
    clear-corner: func();
    /// A point in the world, in blocks.
    record world-point {
        x: f64,
        y: f64,
        z: f64,
    }
    /// One world-space line: the two ends, a 0xAARRGGBB colour, and
    /// a width in pixels (0.5 to 8, as the game's gizmos use 1 to 4).
    record world-line {
        start: world-point,
        end: world-point,
        /// 0xAARRGGBB.
        color: u32,
        /// Pixels wide, 0.5 to 8.
        width: f32,
    }
    /// One world-space box: the two opposite corners, a 0xAARRGGBB
    /// colour, and a width in pixels. Drawn as its twelve edges, in
    /// `CuboidGizmo.emit`'s order.
    record world-box {
        min: world-point,
        max: world-point,
        /// 0xAARRGGBB.
        color: u32,
        /// Pixels wide, 0.5 to 8.
        width: f32,
    }
    variant world-shape {
        line(world-line),
        box(world-box),
    }
    /// Replaces the mod's world shapes: up to 1024 lines (a box
    /// counts as 12), drawn every frame in order over the world,
    /// depth-tested so walls hide them, hidden with the HUD (F1).
    /// An empty list removes them. Nothing here is ever drawn on
    /// top of everything.
    set-world: func(shapes: list<world-shape>);
    /// The width of one line of text in GUI pixels, in the HUD's font: exact
    /// for Latin letters (U+0000 to U+024F), 6 per other character.
    text-width: func(text: string) -> f32;
    record frame-rate {
        /// Frames drawn in the last second.
        fps: u32,
        /// The slowest frame's rate, and the 1% low (the 99th percentile
        /// frame time's rate), over the last 5 seconds.
        min: u32,
        low: u32,
    }
    /// The game's frame counter, recomputed twice a second.
    frame-stats: func() -> frame-rate;
    /// Caps the frame rate at `fps` while set (none lifts the cap):
    /// the game's frame limiter runs at the lowest of the player's
    /// Max Framerate, the game's own inactivity and battery limits,
    /// and every running mod's cap. 1 to 240; a cap can only ever
    /// lower the rate, never raise it past the player's settings.
    /// The world still ticks at full rate — only frames are paced.
    set-fps-cap: func(fps: option<u32>);
    record zoom {
        /// The field of view is divided by it: 1 is none, at most 250.
        factor: f32,
        /// Ease in and out through the game's field-of-view easing, as the
        /// spyglass does, instead of at once.
        smooth: bool,
        /// Mouse turning is multiplied by it while zoomed: 1 keeps the
        /// player's sensitivity, at least 0.05.
        turn: f32,
    }
    /// Zooms the camera until the next call (`factor` 1 ends it), only
    /// while playing: a screen opening or the spyglass's own view (which
    /// wins) leave the camera vanilla's. With several mods, the strongest
    /// zoom counts.
    set-zoom: func(zoom: zoom);
    /// Whether a `set-zoom` would take effect now: the player is in
    /// the world with no screen open, and not scoping. When this is
    /// false a zoom is kept but not shown.
    can-zoom: func() -> bool;
    /// The zoom the spyglass is showing, while the player scopes
    /// with one in first person: the factor the view is narrowed by
    /// (10 in this game). None while not scoping. Holding a spyglass
    /// without scoping is `input.held`'s answer, not this one's.
    get-spyglass-zoom: func() -> option<f32>;
    /// How the hand's field of view follows the view's, while zoomed.
    enum hand-fov-mode {
        /// The hand's FOV is scaled by the view's zoom ratio.
        multiply,
        /// The view's zoom shift, in degrees, is added to the hand's FOV.
        add,
        /// The hand keeps its own FOV (what vanilla does).
        keep,
    }
    record hand-fov {
        mode: hand-fov-mode,
        /// The hand FOV to work from, in degrees: the base the mode
        /// adjusts. (Zoomify's setting is the mode alone over the
        /// vanilla 70; the base is here for mods that pose the hand
        /// at another width.)
        base: f32,
    }
    /// Makes the first-person hand's field of view follow the view's
    /// zoom by `mode` over `base`, until the next call (none restores
    /// vanilla's: a fixed 70 degrees, moved only by the death and
    /// fluid effects). One hand FOV applies: the first loaded mod
    /// that sets one, as with the minimap. A stopped mod's setting
    /// goes with it.
    set-hand-fov: func(hand-fov: option<hand-fov>);
    record minimap {
        corner: corner,
        /// Its side in GUI pixels, 16 to 256.
        size: f32,
        /// World blocks per map pixel, 0.5 to 4; the map is 128 × 128 pixels.
        blocks-per-pixel: f32,
        /// The map turns with the player, who faces up, and an N on its rim
        /// marks north. Otherwise north is up and the player's arrow turns.
        rotate: bool,
        /// Round, the corners left clear; otherwise square.
        round: bool,
    }
    /// Shows a map of the world around the player in `corner`, stacked with
    /// the game's overlays and the mods' panels, until the next call (none
    /// hides it). It looks like a map item: vanilla's map colours with their
    /// height shading and water depth, and the player's arrow. Underground,
    /// under a roof and in the Nether it maps the floor around the player's
    /// height. The game keeps the map's tiles and refreshes them within its
    /// own frame budget; hidden, they are dropped. One map shows at a time:
    /// the first loaded mod's.
    set-minimap: func(minimap: option<minimap>);
    record far-terrain {
        /// How far the distant terrain reaches, in chunks: 64 to 1024. On
        /// integrated graphics other than Apple's the game caps it lower.
        distance: u32,
        /// Coarser far tiles, as the Far Detail setting's Reduced: 2 to 4 ms
        /// less GPU time per frame on integrated graphics.
        reduced: bool,
    }
    /// Draws the world beyond the render distance as distant terrain, out to
    /// `distance` chunks, until the next call (none ends it). The game builds
    /// it on its own workers, from the chunks already loaded or saved and,
    /// where nobody has been, from the world's generator; the simulation
    /// distance doesn't change. Only worlds whose generator the game has
    /// (single player and a LAN world you host) show it. The player's own LOD
    /// Distance setting, when on, wins. One far terrain shows at a time: the
    /// first loaded mod's.
    set-far-terrain: func(far-terrain: option<far-terrain>);
    /// The brightness the renderer is applying right now, as a gamma value:
    /// the strongest gamma any running mod set, or the player's own
    /// Brightness setting when no mod sets one. 0.5 is the vanilla default,
    /// 1.0 the brightest the options screen allows. Values above 1.0 come
    /// only from a mod.
    get-gamma: func() -> f32;
    /// Sets this mod's gamma until the next call: 0.0 is the darkest the
    /// lightmap goes, 1.0 is the brightest the options screen allows, and
    /// values above 1.0 brighten further with diminishing returns — the
    /// lightmap saturates toward white, so colours wash out as the value
    /// grows. 10.0 is the 1000% Fullbright mods use. Values are clamped to
    /// 0.0..=10.0; a non-finite value reads as 1.0. The strongest gamma any
    /// running mod sets wins; when no running mod sets one, the player's own
    /// Brightness setting applies again. The player's stored setting is never
    /// changed. Only while playing: at the title screen there is no renderer
    /// to brighten, and the value is the stored setting.
    set-gamma: func(value: f32);
    /// Whether distance fog is drawn right now: false while any running mod
    /// turned it off, otherwise the player's own Fog setting. Distance fog is
    /// the atmospheric and render-distance fog, including the Nether's; the
    /// fog of water, lava and powder snow, blindness, darkness and a boss's
    /// world fog are never removed by this.
    get-fog: func() -> bool;
    /// Sets this mod's distance-fog flag until the next call: false removes
    /// distance fog (the same removal the Fog setting in the graphics options
    /// does), true leaves the player's setting alone. Any running mod turning
    /// fog off turns it off; when no running mod turns it off, the player's
    /// own Fog setting applies again. The player's stored setting is never
    /// changed. Only while playing.
    set-fog: func(enabled: bool);
    /// Hides the HUD while true: the hotbar, crosshair, bars, chat,
    /// overlays and every mod's panels, the player's own included —
    /// what F1 hides, for as long as any running mod asks. Screens,
    /// the debug screen and the sleep overlay still draw, as with
    /// F1. The hand hides with the HUD, as it does under F1.
    set-hide-hud: func(hidden: bool);
    /// The camera this frame renders from.
    record camera-pose {
        /// World position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
        /// Degrees of roll about the view direction: 0 is level,
        /// positive rolls clockwise as the player sees it.
        roll: f32,
    }
    /// What a mod asks the camera to do. `position` decides the
    /// mode: none keeps the camera at the player's eye and only
    /// the look changes (freelook); some detaches the camera to
    /// that position (freecam).
    record camera-override {
        /// None: freelook; some: freecam at this position.
        position: option<world-point>,
        /// The look direction the camera starts from. The mouse
        /// then turns it until the next call: a call replaces the
        /// look, it does not add to it.
        yaw: f32,
        pitch: f32,
        /// Degrees of roll about the view direction, -180 to 180.
        roll: f32,
    }
    /// The camera this frame renders from: the mod override when
    /// one is active, else the player's own camera (the first-person
    /// eye, or the third-person back-off). Only while playing.
    get-camera: func() -> camera-pose;
    /// Detaches the camera until the next call (none releases it):
    /// freelook while `position` is none, freecam while it is some.
    /// Only one mod drives the camera: the first loaded mod that
    /// sets one wins; the others' calls are stored but ignored
    /// until it releases. While a camera is active the mouse turns
    /// the camera, not the player — the player's yaw and pitch do
    /// not move, so the player keeps walking, aiming and mining in
    /// the direction they faced. The player's stored settings are
    /// never changed. Only while playing: at the title screen there
    /// is no camera to move, and the value is the panorama's.
    set-camera: func(override: option<camera-override>);
    /// A point on the screen, in GUI pixels from the top left.
    record screen-point {
        x: f32,
        y: f32,
        /// False when the point is behind the camera.
        visible: bool,
        /// Blocks from the camera along the view direction;
        /// negative behind it.
        depth: f64,
    }
    /// Projects a world position onto the screen through the
    /// camera this frame renders from (a mod camera when one is
    /// active, else the player's own), with the effective field
    /// of view, including a mod zoom. `visible` is false behind
    /// the camera; `x` and `y` are still given, so a mod can draw
    /// an off-screen arrow itself. No occlusion test: a point
    /// behind a wall still projects, as the HUD distances do.
    /// Only while playing.
    project: func(point: world-point) -> screen-point;
}

/// Capability `audio` (API 15): the shared reverb's character. The
/// mod that answers sound events (interface `audio-events`) sets
/// this from its estimate of the listener's surroundings; the game
/// owns the effect itself and applies it in the mixer.
interface audio {
    /// Set the shared reverb: a wet gain of 0.0..=1.0 and a decay
    /// time in seconds (0.1..=10.0). Out-of-range values are clamped.
    set-environment: func(wet: f32, decay: f32);
    /// Return the shared reverb to dry (a wet gain of 0).
    clear-environment: func();
}

/// Capability `render` (API 16): the first-person hand's pose. The
/// game hands the mod the hand's state each frame; the mod hands
/// back one transform the game multiplies into the pose of both the
/// arm and the held item, after the vanilla pose. While a two-handed
/// map is held the game ignores offsets: that pose is its own.
/// API 17 adds the swing's own terms: a mod can read which swing
/// animation is playing and scale how much of the vanilla swing
/// pose applies, down to none at all, so its own offset becomes
/// the whole swing animation.
interface hand {
    /// What a swing is, as far as the game can honestly tell: the
    /// swing state records an animation and a hand, not which click
    /// started it, so `use` is a swing of the hand that is using an
    /// item while it uses it, `attack` is every other swing (the
    /// plain whack and a spear's stab alike), and `other` is no
    /// swing at all.
    enum swing-kind {
        attack,
        %use,
        other,
    }
    /// The engine's own swing animation (API 17): which pose the
    /// game's swing state is playing, as the engine names it — a
    /// `whack` for the plain swing, a `stab` for a spear's jab, and
    /// `none` while no swing runs. This is not the `swing-kind` in
    /// the hand state: that one says what the player is doing with
    /// the swing (attacking, using an item) and is inferred, while
    /// this is the animation itself, exactly as the pose code
    /// plays it.
    enum swing-anim {
        none,
        whack,
        stab,
    }
    /// The first-person hand this frame, as the pose code reads it.
    /// One state covers both hands, as the pose values it mirrors
    /// are the main hand's (the off hand's pose differs in side,
    /// not in these numbers).
    record hand-state {
        /// A swing is running.
        swinging: bool,
        /// The swing's progress, 0 to 1: the value the pose swings
        /// by, of the hand that swings (0 when none does).
        swing-progress: f32,
        swing-kind: swing-kind,
        /// How far the main hand's item has been raised after a swap
        /// or a use: 0 just dropped, 1 fully up (the pose's equip
        /// height).
        equip-progress: f32,
        /// The player's look, degrees, as F3 shows them.
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
        /// How far the look turned since the previous frame's
        /// state, in degrees: the yaw wrapped to -180..180, the
        /// pitch the plain difference. The game works them out, so
        /// a mod need not difference frames itself (its own
        /// differences would read teleports and menu pauses as
        /// turns). Both are 0 on the first state of a session.
        look-delta-yaw: f32,
        look-delta-pitch: f32,
        /// The view bob's phase: the very value the game's bob
        /// reads, its cycle sin(phase * pi) and cos(phase * pi)
        /// over the distance walked. It runs negative as the player
        /// walks forward (vanilla's backwards interpolation), so a
        /// mod that copies the game's own formulas stays in step
        /// with the camera's bob.
        bob-phase: f32,
        /// How strong the view bob is now: 0 standing still or
        /// flying, up to 1 at a full walk.
        bob-amount: f32,
        /// The main hand's item, `minecraft:diamond_sword`; none
        /// when the hand is empty.
        held-item: option<string>,
        /// An item is in use (eating, drinking, drawing a bow,
        /// blocking, ...) in either hand.
        using-item: bool,
        /// A two-handed map is held: the game skips hand offsets
        /// entirely while it is, and the hand shows the map's pose.
        two-handed: bool,
    }
    /// A shift of the hand's pose, in view space: the game applies
    /// the translation, then the rotation (pitch, then yaw, then
    /// roll), after the vanilla pose, to the arm and the held item
    /// alike.
    record hand-transform {
        /// Blocks to the right and up, and towards the viewer:
        /// view space looks along -z, so a punch forward is a
        /// negative z.
        x: f32,
        y: f32,
        z: f32,
        /// Degrees about the view axes.
        pitch: f32,
        yaw: f32,
        roll: f32,
    }
    /// The hand's state, as of the game's last push: the game
    /// pushes once per rendered frame, before the frame hooks run.
    /// Before the first push (the title screen, the first frames)
    /// every field is zero, false or none.
    get-state: func() -> hand-state;
    /// Sets this mod's hand offset, until its next call or
    /// `clear-offset`. There is one hand: the latest call across
    /// the running mods wins. The game clamps what it applies:
    /// translation to ±1 block per axis, rotation to ±60 degrees
    /// per axis, and a non-finite field reads as 0.
    set-offset: func(offset: hand-transform);
    /// Takes this mod's hand offset back. Another mod's offset is
    /// not this call's to clear.
    clear-offset: func();
    /// The swing animation playing now (API 17), as of the game's
    /// last push, read the way `get-state` reads the hand state.
    get-swing-anim: func() -> swing-anim;
    /// How much of the vanilla swing pose applies (API 17): 1.0 is
    /// vanilla in full, 0.0 is none of it — the mod's own offset,
    /// driven by the swing's progress, is the whole animation —
    /// and up to 2.0 exaggerates the vanilla swing. The base
    /// equip pose is never scaled, only the swing's own terms, so
    /// 0.0 leaves the hand exactly at its rest pose. Poses that
    /// are not swings (using, charging, eating, ...) are never
    /// scaled. There is one swing: the latest call across the
    /// running mods wins, as with the offset, and a stopped mod's
    /// value is dropped with it. The game clamps to 0.0..=2.0 and
    /// a non-finite value reads as 1.0. Writing 1.0 hands the
    /// swing back to vanilla; there is no separate clear.
    set-swing-scale: func(scale: f32);
}

/// Capability `actions` (experimental: the manifest needs
/// `experimental = ["actions"]`): the player's own clicks, made by
/// the game for the mod. Every request is performed as the player,
/// with the player's permissions, through the same path a real
/// click takes — the server sees ordinary clicks and may refuse
/// any of them, and a request the game cannot perform (a screen is
/// open, an item is in use, the target has moved) is dropped, not
/// queued for later. Requests made in a hook are performed after
/// the hook returns, in the next tick's input step, in the order
/// they were made; at most 8 are kept from one hook call and at
/// most 8 from one mod in one tick.
interface actions {
    /// Which hand an action uses. `use` on its own tries the main
    /// hand, then the off hand, as a click does.
    enum hand {
        main,
        off,
    }

    /// The face of a block a hit landed on, as the game's pick
    /// names it.
    enum face {
        down, up, north, south, west, east,
    }

    /// A block the player is looking at, with what a use needs:
    /// the face hit and where on the block the view met it (each
    /// 0 to 1 within the block). As of this tick.
    record block-target {
        block-x: s32,
        block-y: s32,
        block-z: s32,
        /// `minecraft:wheat[age=7]`, ...
        block: string,
        face: face,
        cursor-x: f32,
        cursor-y: f32,
        cursor-z: f32,
    }

    /// An entity the player is looking at: the id `entity`
    /// lists it by. As of this tick.
    record entity-target {
        id: u32,
        kind: string,
        /// Blocks from the eye to the hit point.
        distance: f32,
    }

    /// What is under the crosshair now, block or entity, in the
    /// game's own pick order (an entity in front of a block is
    /// the target; the block behind it is not offered). (Not
    /// named `target`: a WIT interface's types and functions
    /// share one namespace, and `target` is the function below.)
    variant crosshair-target {
        block(block-target),
        entity(entity-target),
    }

    /// The crosshair's target, as the game picks it this tick:
    /// the block within block reach, or the entity in front of
    /// it. None when nothing is hit, and on the title screen.
    /// (`game.raycast` cannot serve here: its hit has no face,
    /// and a use needs the face.)
    target: func() -> option<crosshair-target>;

    /// One click of the use button, exactly as the player
    /// clicking: the entity under the crosshair is used first,
    /// then the block (it reacts, or the held item is placed
    /// against it), then the held item itself; the off hand has
    /// its turn when the main hand's passes. A click while an
    /// item is in use is drained by the game, as a real one is.
    %use: func();

    /// One use of `hand` on this block target: the block reacts
    /// or the hand's item is used on it (a block item is placed
    /// against `face`), as a click aimed at it would. For a
    /// target `target` gave earlier: when the action is
    /// performed, the game picks again, and if the crosshair no
    /// longer rests on this block and face the request is
    /// dropped — a mod can only ever use what the player is
    /// looking at. Errs only on a target that is malformed now
    /// (a face's cursor outside the block); a dropped request is
    /// not an error.
    use-on-block: func(target: block-target, hand: hand) -> result<_, string>;

    /// One click of the attack button, exactly as the player
    /// clicking: an entity under the crosshair is attacked, a
    /// block under it starts (or, in creative, completes) being
    /// mined, air is swung at. Holding the button is `set-held`;
    /// this is the click alone.
    attack: func();

    /// Holds the attack and/or use buttons down for the mod, as
    /// if the player held them: held use repeats at the game's
    /// own cadence (every 4 ticks, never while an item is in
    /// use), held attack keeps mining the block under the
    /// crosshair and swings at what it meets. Either button the
    /// player is really holding is unaffected — this adds a
    /// second, virtual holder of the same buttons, and the game
    /// reads a button as down while either holds it. The hold
    /// ends when the mod calls this with both false, when the
    /// mod stops, when a screen opens, or when the world is
    /// left; it does not survive any of those.
    set-held: func(attack: bool, %use: bool);

    /// Chooses hotbar slot 0 to 8, as the hotbar keys or the
    /// wheel do: the server is told in the same tick's step, and
    /// a claimed use in progress ends, as on a real switch. Errs
    /// on a slot outside 0 to 8.
    select-slot: func(slot: u32) -> result<_, string>;
}

/// Capability `screen` (experimental: the manifest needs
/// `experimental = ["screen"]`): the game's own screens, as a
/// mod may see and decorate them. Which screen is open and what
/// it holds; buttons of the mod's that the game places on the
/// screens named below and the player presses; highlights over
/// slots; the merchant's offers and its own trade choice; and
/// the debug screen's surface. Nothing here moves a stack
/// between slots, edits a menu or draws free pixels over a
/// screen: the game keeps the layout, as it does for `ui`.
interface screen {
    /// The open screen, as of this tick. `playing` while no
    /// screen is open; `title` on the title screen.
    record screen-state {
        /// `playing`, `paused`, `inventory`, `creative`,
        /// `options`, ..., `title`: the game's own screen ids,
        /// the ones its hooks have always used.
        id: string,
        /// The type of the menu the server opened for this
        /// screen (`minecraft:generic_9x3`, `minecraft:furnace`,
        /// `minecraft:merchant`, a mount's own id, ...). None on
        /// a screen without one — the player's own inventory,
        /// creative, pause — and on the title.
        menu: option<string>,
        /// The open menu's title, as plain text, when the server
        /// gave one.
        title: option<string>,
        /// The screen's container panel in GUI pixels (x, y,
        /// width, height); the whole window for a screen with
        /// none.
        rect: tuple<f32, f32, f32, f32>,
        /// The slot the pointer rests on, in `inventory`'s
        /// numbering, when it rests on one of the open screen's
        /// slots.
        hovered-slot: option<u32>,
        /// The game's debug overlay (F3) is open. It is not a
        /// screen: it can be open over `playing` or a screen.
        debug-open: bool,
    }

    /// The open screen. On the title screen the id is `title`
    /// and everything else is empty; a mod's own screen and
    /// another mod's screen both read as `mod`.
    state: func() -> screen-state;

    /// A stack a trade names, as `browser.stack` spells it:
    /// its id, a count, and its components beyond the item's
    /// own in vanilla's item syntax, or "".
    record trade-stack {
        item: string,
        count: u32,
        components: string,
    }

    /// One of the merchant's offers. `cost-a`'s count is the
    /// count the screen charges (the base count with the
    /// demand and special-price adjustments the villager
    /// applies), not the offer's base count.
    record trade-offer {
        cost-a: trade-stack,
        cost-b: option<trade-stack>,
        %result: trade-stack,
        /// Trades completed with this offer.
        uses: u32,
        /// Trades the offer allows before it locks.
        max-uses: u32,
        /// The payments are staged or takeable now and the
        /// offer is not locked: what the screen shows as an
        /// offer the player can trade.
        available: bool,
    }

    /// The merchant screen's offers, while one is open.
    record trade-list {
        offers: list<trade-offer>,
        /// The offer the screen has selected (the one a trade
        /// choice or a result take acts on), when one is.
        selected: option<u32>,
    }

    /// The open merchant's offers; none while no merchant
    /// screen is open. (The container record `inventory` reads
    /// deliberately carries no offers; they live here.)
    trades: func() -> option<trade-list>;

    /// Where on its screen the game puts a button. The game
    /// computes the place from the screen's own geometry, as
    /// it does for its own extra buttons; a button whose
    /// anchor does not fit its screen is not drawn.
    enum anchor {
        /// Beside the open container's title (a chest's, the
        /// merchant's, ...), where the game's sort button sits.
        container-head,
        /// Beside the "Inventory" label of the inventory part
        /// of the screen.
        inventory-head,
        /// In the pause menu's column of buttons, after its
        /// own.
        menu-column,
        /// In the title screen's row of buttons.
        title-row,
    }

    /// A button of the mod's on one of the game's screens.
    record screen-button {
        /// The mod's own name for the button; `poll` echoes it.
        id: u32,
        /// The screen it belongs to: `inventory`, `paused` or
        /// `title` in v1.
        screen: string,
        /// Only while this menu type is open (a chest's buttons
        /// are not a furnace's). None: every open of `screen`.
        menu: option<string>,
        anchor: anchor,
        /// Its label, up to 64 characters.
        label: string,
        /// An item whose icon leads the label
        /// (`minecraft:diamond`, `<mod>:<path>`); none for a
        /// text-only button. A mod cannot draw its own sprite
        /// here.
        icon: option<string>,
    }

    /// Replaces the mod's declared buttons, on every screen:
    /// at most 16; for one screen-and-menu context the first
    /// 8 that fit are drawn, in this order, and a declaration
    /// survives until replaced or the mod stops. Declare them
    /// once (in `init`, or when settings change), not per
    /// frame.
    set-buttons: func(buttons: list<screen-button>);

    /// A slot of the open screen to mark, in `inventory`'s
    /// numbering, and the mark's colour (0xRRGGBB, drawn
    /// translucent over the slot, under its stack's tooltip).
    record highlight {
        slot: u32,
        color: u32,
    }

    /// Replaces the slots this mod marks on the open
    /// inventory/container screen: at most 512. They belong to
    /// the screen that is open when they are drawn — the game
    /// draws none once it closes, and a list set for one
    /// screen is not carried onto the next. An empty list
    /// clears them.
    set-highlights: func(slots: list<highlight>);

    /// What the player did on this mod's part of a screen.
    variant screen-event {
        /// A button the mod declared was pressed: its `id`.
        /// The press is the player's own; the game has already
        /// kept it from the screen's slots.
        button(u32),
        /// The middle button went down over the open
        /// inventory/container screen: the slot under the
        /// pointer, in `inventory`'s numbering, or none over
        /// no slot. Observed, never consumed: the game's own
        /// use of the press (a creative clone) still happens.
        middle-click(option<u32>),
    }

    /// What the player did since the last poll, at most 256
    /// kept.
    poll: func() -> list<screen-event>;

    /// Chooses the merchant's trade `index`, as clicking the
    /// offer on the merchant screen does: the game sends the
    /// selection and the server stages the payments and the
    /// result from the player's inventory. Taking the result
    /// is a slot click, and is not this call. Performed after
    /// the hook returns, in the next tick, only while the
    /// merchant screen is still open; dropped then if it is
    /// not, or the index names no offer. Errs only when no
    /// merchant screen is open as of this tick.
    select-trade: func(index: u32) -> result<_, string>;

    /// Stands in for the game's debug overlay (F3): while any
    /// running mod claims it, the game does not draw its own
    /// debug entries, and whether it is open is `state`'s
    /// `debug-open` for every mod. The claiming mod draws its
    /// replacement with its own `hud`/`render` surfaces. The
    /// claim ends when the mod calls this with false or stops.
    claim-debug: func(claimed: bool);
}

/// Capability `inventory-actions` (experimental: the manifest
/// needs `experimental = ["inventory-actions"]`): the player's
/// own slot clicks, made by the game for the mod. Every click
/// is performed as the player, in the menu that is open when it
/// is performed, through the game's own menu logic — the server
/// sees ordinary clicks, re-runs them itself, and corrects
/// anything it sees differently. A click the game cannot
/// perform when its tick comes (no menu it fits, the screen
/// closed, the slot not one of the open menu's) is dropped, not
/// queued for later; what a click did is read back from
/// `inventory` on the next tick, never promised. Requests made
/// in a hook are performed after the hook returns, in the next
/// tick, in the order they were made; at most 32 are kept from
/// one hook call and at most 64 from one mod at a time (a drag
/// counts as 8).
interface inventory-actions {
    /// A click's kind, as the game's menu engine names them
    /// (the ContainerClick packet's own list).
    enum click-kind {
        /// Left (button 0) or right (1) click: take, put, merge
        /// or swap, as the hand and the slot dictate. With no
        /// slot (outside the window) it drops what the hand
        /// carries: all of it (0) or one of it (1). The only
        /// kind that means anything with no slot.
        pickup,
        /// Shift-click (button 0 or 1): move the slot's stack
        /// to the other side of the menu.
        quick-move,
        /// Swap the slot with a hotbar slot: the button is the
        /// hotbar slot, 0 to 8, or 40 for the off hand.
        swap,
        /// The pick-block click (button 0): a full copy of the
        /// slot's stack onto the empty hand. The game's menu
        /// engine only clones in creative mode; in survival the
        /// click does nothing, as the player's own would.
        clone,
        /// Drop from the slot (the hand must be empty): button
        /// 0 drops one, 1 drops the whole stack.
        throw,
        /// The double click (button 0 or 1): gather stacks of
        /// the slot's item onto the hand from the menu's slots.
        pickup-all,
    }

    /// One click on a slot of the open menu, in `inventory`'s
    /// numbering (0-8 hotbar, 9-35 main inventory, 100-108
    /// crafting grid, 200 its result, 300+ the open container's
    /// own slots, 500-503 armour, 504 off hand; a workstation's
    /// inputs are 600 up and its result 650). `slot` is none for
    /// a click outside the window. Errs only on an argument that
    /// is malformed now: a slot past 999, or a button the kind
    /// does not take (pickup, quick-move, throw and pickup-all
    /// take 0 or 1; swap takes 0 to 8 or 40; clone takes 0). A
    /// dropped click is not an error.
    click: func(slot: option<u32>, button: u32, kind: click-kind) -> result<_, string>;

    /// The button a drag is made with: it also chooses how the
    /// hand's stack is shared out, as the player's own drags
    /// do — left spreads it evenly over the slots, right puts
    /// one in each, middle puts a full stack in each (creative
    /// only; the engine refuses it otherwise).
    enum drag-button {
        left,
        right,
        middle,
    }

    /// A drag of the hand's stack over `slots`, in the order
    /// given: the whole gesture is performed as one drag, as
    /// releasing the button over those slots would. At most 64
    /// slots; empty errs. Slots the drag cannot take (a result
    /// slot, a slot of another item) are passed by, as the
    /// game's own drag passes them. Performed whole or dropped
    /// whole: a drag is one gesture in the game's menu logic
    /// and cannot be split across ticks.
    drag: func(button: drag-button, slots: list<u32>) -> result<_, string>;

    /// A turn of the mouse wheel over the open inventory or
    /// container screen since the last poll: the slot the
    /// pointer rested on, in `inventory`'s numbering (none over
    /// no slot), and the whole steps turned (positive: items
    /// move toward the inventory, the direction the game's own
    /// wheel tweak calls down). Observed, never consumed: the
    /// game's own uses of the wheel still happen.
    record wheel-event {
        slot: option<u32>,
        steps: s32,
    }

    /// The wheel turns over the open screen since the last
    /// poll, at most 256 kept.
    poll-wheel: func() -> list<wheel-event>;
}

/// Capability `map` (experimental: the manifest needs
/// `experimental = ["map"]`): the game's own mapping of the
/// ground around the player, a full-screen map of the mod's
/// own, and the places the player died and came back. The
/// tiles are the game's, computed for its minimap from the
/// chunks it has loaded; they are a view, not an archive —
/// they reach only as far as the loaded chunks, in the
/// dimension the player is in, one layer at a time, and they
/// go when the chunk does. A mod that wants a map of
/// everywhere it has been reads the tiles as it travels and
/// keeps them in its own storage, keyed by `context`.
interface %map {
    /// A chunk's position, in chunk coordinates.
    record chunk-pos {
        x: s32,
        z: s32,
    }

    /// Which of the game's map layers a tile was scanned at.
    enum map-layer {
        /// The top block of each column, as map items show it.
        surface,
        /// Underground, under a roof or in the Nether: the
        /// floor below the player's head, walls cut at it.
        cave,
    }

    /// One chunk of the game's map: what its minimap holds of
    /// that chunk, column by column (`z * 16 + x`, as the game
    /// stores them). Shading is the map item's, and a mod
    /// holding the tile has everything it needs of it: a
    /// column is brighter facing a lower north neighbour and
    /// darker facing a higher one, water darkens with depth,
    /// and a cut wall reads brightest of all.
    record map-tile {
        chunk-x: s32,
        chunk-z: s32,
        layer: map-layer,
        /// A cave tile's cut: the head height its floor and
        /// walls were scanned at. None on a surface tile.
        cut-y: option<s32>,
        /// The tile's version: it grows each time the tile's
        /// content changes, and starts over when the game's
        /// map does (a new dimension, a new world).
        version: u64,
        /// The vanilla map colour of each column (a map colour
        /// id, 0 for none), 256 of them. A cave tile's cut
        /// walls carry the game's wall mark, the extra bit
        /// 0x80, on their colour.
        colors: list<u8>,
        /// Each column's height: the y its colour was scanned
        /// at, 256 of them.
        heights: list<s16>,
        /// How deep the fluid over each column runs, 256 of
        /// them: the depth the map's water shading darkens by.
        depths: list<u8>,
    }

    /// The game's tiles of `chunks`, in the order asked;
    /// chunks it holds no tile for are left out. At most 64
    /// chunks a call; a call over the cap returns no tiles.
    /// The tiles are the current dimension's, at the layer
    /// the game's minimap is mapping now (the surface, or the
    /// cave floor at the player's head while under a roof or
    /// in the Nether), as of this tick. A tile the game has
    /// not scanned yet reads as absent, not as empty ground:
    /// the scan runs within the game's own frame budget,
    /// nearest first, so ground just arrived may take a few
    /// frames to appear.
    tiles: func(chunks: list<chunk-pos>) -> list<map-tile>;

    /// One chunk's tile version, without the tile.
    record tile-version {
        chunk-x: s32,
        chunk-z: s32,
        version: u64,
    }

    /// The versions of the game's tiles of `chunks`: a mod
    /// keeping its own map polls these over the ground it has
    /// covered and re-reads only the tiles whose version
    /// moved. At most 256 chunks a call; chunks with no tile
    /// are left out.
    tile-versions: func(chunks: list<chunk-pos>) -> list<tile-version>;

    /// Where the player is playing, for keying a mod's own
    /// stored maps and waypoints.
    record map-context {
        /// `minecraft:overworld`, `minecraft:the_nether`, ...,
        /// as `game.player` names the dimension.
        dimension: string,
        /// The world, as the game names it: a single-player
        /// world's own name, or the address of the server, as
        /// the player typed it.
        %world: string,
    }

    /// The context the player is in: maps and waypoints are
    /// per world, server and dimension, and the game alone
    /// knows all three. None on the title screen.
    context: func() -> option<map-context>;

    /// A place in the world: a dimension and a block position.
    record position {
        dimension: string,
        x: s32,
        y: s32,
        z: s32,
    }

    /// Where the player last died, as the game itself keeps
    /// it — the recovery compass reads the same place. The
    /// server tells the client at login and at respawn, and
    /// the game keeps it between sessions. None when the
    /// player has not died in this world.
    last-death: func() -> option<position>;

    /// A death or a return, as it happened.
    variant position-event {
        /// The player died: where, captured as the death
        /// screen opened.
        died(position),
        /// The player came back: where they stand now.
        respawned(position),
    }

    /// Deaths and respawns since the last poll, in the order
    /// they happened, at most 256 kept, oldest dropped. A
    /// death here is a death the death screen opened for —
    /// every death the player sees is one.
    poll-events: func() -> list<position-event>;

    /// An image the mod composed, palette-indexed: `pixels`
    /// is `width` by `height` indices into `palette`, row by
    /// row from the top left, each naming a colour
    /// 0xAARRGGBB (an alpha of 0 leaves what is under it).
    /// The image's centre pixel sits at (`center-x`,
    /// `center-z`) in the world, at `blocks-per-pixel` blocks
    /// per pixel.
    record map-image {
        center-x: s32,
        center-z: s32,
        /// World blocks per image pixel.
        blocks-per-pixel: f32,
        width: u32,
        height: u32,
        /// At most 256 colours, 0xAARRGGBB.
        palette: list<u32>,
        /// Exactly `width` by `height` indices.
        pixels: list<u8>,
    }

    /// A mark on the map screen: a coloured square with the
    /// label's first letter in it and the label under it,
    /// drawn by the game where (`x`, `z`) falls in the view.
    record map-marker {
        /// A block position.
        x: s32,
        z: s32,
        /// 0xAARRGGBB.
        color: u32,
        /// Up to 64 characters; an empty label draws the
        /// square alone.
        label: string,
    }

    /// The mod's full-screen map: its composed image, and the
    /// marks the game draws over it.
    record map-screen {
        image: map-image,
        /// At most 128, drawn in order.
        markers: list<map-marker>,
    }

    /// Shows the mod's full-screen map until the next call
    /// (none closes it, and the mod hears no `closed` for
    /// that: it was its own doing). The game draws the image
    /// to fill the screen and fields the pointer over it: a
    /// drag pans, the wheel zooms toward the pointer, clicks
    /// are the mod's through `poll-map`, and Esc closes the
    /// map (the mod hears `closed`). While it is open, the
    /// open screen reads as a map screen (`screen.state`'s
    /// "map"). The view starts at the image's centre and
    /// scale; panning stays within the image, and zooming
    /// keeps the view between 0.125 and 128 blocks per
    /// pixel. One map screen at a time: a second mod's call
    /// replaces the first's, which hears `closed`.
    set-map-screen: func(screen: option<map-screen>);

    /// The map screen's view, as the game now shows it.
    record map-view {
        /// The world position of the view's centre.
        center-x: f64,
        center-z: f64,
        blocks-per-pixel: f32,
    }

    /// A click on the map screen: where it fell, in world
    /// blocks, and the button (0 left, 1 right, 2 middle).
    record map-click {
        x: f64,
        z: f64,
        button: u32,
    }

    /// What the player did on the map screen.
    variant map-event {
        clicked(map-click),
        /// The view came to rest somewhere new (a drag ended,
        /// the wheel turned): where it rests now. A mod whose
        /// image is composed around the view re-centres when
        /// the view nears the image's edge.
        view(map-view),
        /// The player closed the map (Esc), another screen
        /// took its place, or another mod's map replaced it.
        closed,
    }

    /// What the player did on the map screen since the last
    /// poll, at most 256 kept, oldest dropped.
    poll-map: func() -> list<map-event>;

    /// A corner of the screen (redeclared: WIT interfaces
    /// cannot share types).
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }

    /// The mod's own minimap: an image it composed, in a
    /// corner.
    record minimap-image {
        corner: corner,
        /// Its side in GUI pixels, 16 to 256.
        size: f32,
        /// Round, the corners left clear; otherwise square.
        round: bool,
        image: map-image,
    }

    /// Shows the mod's own map image in a corner until the
    /// next call (none hides it): a minimap the mod draws
    /// itself — its own shading, its own dots — from `tiles`,
    /// stacked with the game's overlays and the other mods'
    /// panels, as `render.set-minimap`'s map is. A corner
    /// holds one map: while any mod's image shows it stands
    /// in for the game's terrain map there, and among image
    /// maps the first loaded mod's wins, as with
    /// `render.set-minimap`.
    set-minimap-image: func(image: option<minimap-image>);
}

/// Capability `render` (API 20): player models' poses. The game
/// hands the mod every drawn player's pose inputs each frame —
/// the local player's first — and the mod hands back per-part
/// offsets the game folds into the finished vanilla pose, the
/// hand district's bargain carried to whole bodies. A pose scale
/// says how much of the vanilla pose applies at all: at 0 the
/// model stands in its rest pose and the mod's offsets are the
/// whole animation. Only players (and mannequins) are posed;
/// the shifts are cosmetic on this client only — they never
/// move a hitbox, a camera or another player's screen.
interface entity-pose {
    /// Which posed player a state or a write is about: the
    /// mod's own player, or another player (or mannequin) by the
    /// entity id `entity.entities` and the pose states use.
    variant pose-target {
        self-player,
        entity(u32),
    }

    /// What one hand's arm is doing, as the pose code decides it
    /// (`HumanoidModel`'s arm poses, exactly the engine's own
    /// classification — not inferred from the held item).
    enum arm-pose {
        empty,
        item,
        block,
        bow,
        crossbow-hold,
        crossbow-charge,
        throw-trident,
        toot-horn,
        spear,
        brush,
    }

    /// The hand using an item: which one, the item, and how
    /// long it has been in use, in ticks.
    record item-use {
        off-hand: bool,
        item: string,
        ticks: u32,
    }

    /// One player model's pose inputs this frame: the values the
    /// game's own pose code reads, at the partial tick the frame
    /// is composed with. Only players are listed: the local
    /// player first (`self` set), then the other players the
    /// client is drawing, nearest first, at most 32.
    record entity-pose-state {
        id: u32,
        kind: string,
        self: bool,
        /// Walk cycle: the position the leg swing reads and its
        /// speed, 0 while riding or standing (vanilla zeroes
        /// both for a passenger).
        walk-pos: f32,
        walk-speed: f32,
        /// Head yaw relative to the body, and head pitch,
        /// degrees — the head pose's own inputs.
        head-yaw: f32,
        head-pitch: f32,
        /// The swing's progress, 0 to 1 (0 while no swing runs),
        /// of the arm that swings; `swing-anim` is the engine's
        /// own kind (the API 17 enum: none / whack / stab), and
        /// `swing-off-hand` says the off hand's arm swings.
        swing-progress: f32,
        swing-anim: swing-anim,
        swing-off-hand: bool,
        main-arm-pose: arm-pose,
        off-arm-pose: arm-pose,
        main-hand: option<string>,
        off-hand: option<string>,
        /// An item in use (eating, drinking, drawing a bow,
        /// blocking, charging a spear...), if either hand is.
        using: option<item-use>,
        crouching: bool,
        /// Riding any vehicle or mount.
        riding: bool,
        /// The swim stroke's amount, 0 to 1 (0 out of the swim
        /// pose); gliding is elytra fall-flying.
        swim-amount: f32,
        gliding: bool,
        sleeping: bool,
        sprinting: bool,
        on-ground: bool,
    }

    /// The engine's own swing animation (the `hand` interface's
    /// enum, re-declared: WIT interfaces cannot share types):
    /// which pose the game's swing state is playing — a `whack`
    /// for the plain swing, a `stab` for a spear's jab, and
    /// `none` while no swing runs.
    enum swing-anim {
        none,
        whack,
        stab,
    }

    /// One part's shift: rotation added to the part's posed
    /// rotation (degrees), and its pivot moved (blocks). Part
    /// names are the model's own: for a player, `head`, `hat`,
    /// `body`, `jacket`, `right-arm`, `left-arm`, `right-sleeve`,
    /// `left-sleeve`, `right-leg`, `left-leg`, `right-pants`,
    /// `left-pants`, and `cape` on the cape. A name the model
    /// does not have is ignored. (`root` is not a part: a
    /// whole-model shift is the `body` pivot's job in this rig,
    /// whose children carry the limbs.)
    record part-offset {
        part: string,
        x: f32,
        y: f32,
        z: f32,
        pitch: f32,
        yaw: f32,
        roll: f32,
    }

    /// A whole pose offset for one target: the parts to shift
    /// and the parts to hide outright (a hidden part and its
    /// children do not draw, as when a spectator's body hides).
    /// Setting an offset replaces the caller's previous one for
    /// that target whole.
    record pose-offset {
        parts: list<part-offset>,
        hidden: list<string>,
    }

    /// This frame's pose states, the local player first. Empty
    /// on the title screen.
    get-pose-states: func() -> list<entity-pose-state>;

    /// Shifts one target's pose (see `pose-offset`). One offset
    /// per target applies: the latest call by any running mod
    /// wins that target, as the hand's one offset wins the hand.
    /// Rotations clamp to ±180 degrees an axis, pivots to ±0.5
    /// blocks an axis, non-finite numbers read as 0. A stopped
    /// mod's offsets go with it.
    set-pose-offset: func(target: pose-target, offset: pose-offset);

    /// Drops the caller's offset for a target (another mod's
    /// offset for it is untouched).
    clear-pose-offset: func(target: pose-target);

    /// How much of the vanilla pose applies to a target: 1 is
    /// vanilla (the default), 0 is none of it — the model stands
    /// in its rest pose and the mod's offset is the animation.
    /// Clamped to 0..=2, non-finite reads as 1. Latest writer
    /// wins per target, as the offsets; writing 1 releases it.
    set-pose-scale: func(target: pose-target, scale: f32);

    /// Shows the player's own body in first person while true
    /// (any running mod asking is enough): the whole model —
    /// body, armour, cape, elytra, held items — except the head
    /// and hat, which never draw in first person. Everything the
    /// pose offsets say applies to it. Third person is
    /// unaffected.
    set-first-person-body: func(shown: bool);
}

/// Capability `render` (experimental), interface `item-model`:
/// how items themselves are shown. A mod may say which item
/// model definition a stack displays as, put marks of its own
/// on the game's item slots, and choose how dropped items lie
/// in the world. Everything here is a picture on this client:
/// no call moves, spends, creates or changes an item, and a
/// rule names definitions that already exist — in the game's
/// own assets, a resource pack, or a content mod's — never a
/// model the mod supplies.
interface item-model {
    /// One component a stack must carry for a match to hold:
    /// its name, and its value in SNBT — the syntax `inventory`
    /// spells components in. The test is against the stack's
    /// full components, the item's own defaults included (a
    /// rarity every dragon egg carries matches; a name only a
    /// renamed stack carries matches that stack).
    record component-match {
        name: string,
        value: string,
    }

    /// What a rule keys on: an item, and every component match
    /// holding. An empty match list keys on the item alone.
    record model-match {
        item: string,
        components: list<component-match>,
    }

    /// Where an item is on display, as a rule names it: the
    /// game's own display contexts, grouped the way mods think
    /// of them. (`ground` is every ground display — a dropped
    /// item, an item on a campfire's grill alike; see the
    /// district's limits for what that means.)
    enum display-context {
        first-person,
        third-person,
        gui,
        ground,
        fixed,
        head,
    }

    /// A stack displays as another item model definition.
    record model-rule {
        match: model-match,
        /// The displays the swap applies to. An empty list
        /// applies nowhere.
        contexts: list<display-context>,
        /// The definition to display instead: the id a stack's
        /// `minecraft:item_model` component would name
        /// (`minecraft:apple`, `eatinganimation:apple`). A rule
        /// naming a definition that does not exist is inert —
        /// the stack displays as itself — never an error and
        /// never the missing model.
        model: string,
    }

    /// Replaces the mod's model rules: at most 64, each with
    /// at most 4 component matches. When rules from several
    /// mods could swap one stack's display, the later-loaded
    /// mod's rule wins; within one mod, the first matching
    /// rule in this list wins. A declaration survives until
    /// replaced or the mod stops. Declare rules once (in
    /// `init`, or when settings change), not per frame.
    set-model-rules: func(rules: list<model-rule>);

    /// What a slot mark keys on: one slot, by number, or every
    /// slot whose stack matches. A stack match with an empty
    /// item matches every item — a mark on a component alone
    /// (a rarity, wherever it sits).
    variant decoration-target {
        slot(u32),
        stack(model-match),
    }

    /// Where a mark shows: on the playing hotbar, on the
    /// inventory and container screens, or both. (The creative
    /// screen's own item grid is not a place; see the limits.)
    enum decoration-place {
        hotbar,
        screens,
    }

    /// A mark on an item slot, drawn by the game in its own
    /// hand: a soft fill under the slot's stack, an outline
    /// around it, a star at its corner. Colours are 0xRRGGBB.
    record decoration {
        target: decoration-target,
        places: list<decoration-place>,
        /// A translucent fill in this colour under the stack —
        /// a glow behind the item. None: no fill.
        fill: option<u32>,
        /// An outline in this colour around the slot, its
        /// bottom edge lit — the game's border hand. None: no
        /// outline.
        border: option<u32>,
        /// A small star at the slot's top-right corner, in the
        /// border's colour, or the fill's when there is no
        /// border. Drawn only when one of them names a colour.
        star: bool,
    }

    /// Replaces the mod's slot marks: at most 256. Marks from
    /// several mods on one slot all draw, in load order. They
    /// survive until replaced or the mod stops; a mark for a
    /// slot no open screen has simply draws nowhere until a
    /// screen has it.
    set-decorations: func(decorations: list<decoration>);

    /// How a dropped flat item (a potion, a tool — an item
    /// whose model is a sprite) lies in the world.
    enum flat-display {
        /// As the game drops it: its full model, spinning.
        vanilla,
        /// One flat face, turned to face you, its edges and
        /// back left undrawn. It still bobs, stacks and glows
        /// as before.
        sprite,
    }

    /// How a dropped block item lies in the world.
    enum block-display {
        /// As the game drops it: its 3D model, spinning.
        vanilla,
        /// Its 3D model whole, turned to face you instead of
        /// spinning.
        billboard,
    }

    /// How dropped items — item entities, and items flying to
    /// the player on pickup — are displayed. Nothing else that
    /// shows an item on the ground (a vault's prize, a thrown
    /// potion) is an item entity, and is not this record's.
    record dropped-display {
        flat: flat-display,
        blocks: block-display,
        /// Dropped items cast the game's round shadow under
        /// themselves. False leaves them shadowless (the game's
        /// own entity-shadows setting still governs the rest).
        shadows: bool,
    }

    /// Sets how dropped items display, for every dropped item
    /// on this client. One policy applies: the latest call
    /// across the running mods wins, as the hand's one offset
    /// wins the hand. Writing the all-vanilla record
    /// (`vanilla`, `vanilla`, `true`) hands the display back;
    /// a stopped mod's policy goes with it.
    set-dropped-display: func(display: dropped-display);
}

/// Capability `render` (experimental), interface
/// `particles`: particles of the mod's own, drawn by the
/// game's own particle engine on this client. A burst is
/// vanilla's own shape — the one the `/particle` command
/// and the server's particle packet use — and everything
/// here is a picture: nothing is sent to the server,
/// nothing in the world changes, and the player's Particles
/// option thins a mod's particles as it thins the game's.
interface particles {
    /// A point in the world, in blocks (redeclared: WIT
    /// interfaces cannot share types).
    record world-point {
        x: f64,
        y: f64,
        z: f64,
    }

    /// The parameters the parameterised particle types
    /// read; a field a type does not read is ignored, and
    /// a type whose parameter is missing does not spawn.
    record particle-params {
        /// 0xAARRGGBB: the colour of `dust` and
        /// `dust-color-transition` (its start colour),
        /// `effect` / `instant-effect` / `entity-effect`,
        /// and the trail's colour. None: the type's own
        /// colour (dust's is red).
        color: option<u32>,
        /// `dust-color-transition`'s end colour, 0xAARRGGBB.
        to-color: option<u32>,
        /// A size: `dust`'s scale, a spell's power,
        /// `sculk-charge`'s roll, `shriek`'s delay in
        /// ticks. Clamped to the range the type itself
        /// clamps to (dust: 0.01 to 4). None: 1.
        scale: option<f32>,
        /// The block whose crumb a `block`, `block-crumble`,
        /// `falling-dust`, `dust-pillar` or `block-marker`
        /// particle shows: `minecraft:stone`, ... Required
        /// by those types; without it they do not spawn.
        block: option<string>,
        /// Where a `trail` particle flies to, and how long
        /// it takes (`duration`, ticks, with it). Required
        /// by `trail`; without it it does not spawn.
        target: option<world-point>,
        /// With `target`: the trail's flight time in ticks,
        /// 1 to 200. None: 20.
        duration: option<u32>,
    }

    /// One burst of particles: `count` of them around
    /// `at`, each offset by a gaussian of `spread` blocks
    /// on each axis and given a gaussian velocity of
    /// `speed` blocks a tick on each axis — the server
    /// packet's own arithmetic. A count of 0 is one
    /// particle at `at` itself, with the velocity
    /// `speed * spread` on each axis: the directional
    /// single.
    record burst {
        /// The particle: a vanilla type
        /// (`minecraft:flame`, or bare `flame`), or a
        /// namespaced type of a sprite set a pack or
        /// content mod carries (`mymod:spark`) — drawn as
        /// a plain billboard, with no gravity and a life
        /// of 20 to 40 ticks, as the game's mod types are.
        /// A name nothing loaded provides spawns nothing.
        particle: string,
        /// With `params`, where the type reads them.
        params: particle-params,
        at: world-point,
        spread: world-point,
        speed: f64,
        /// At most 256; a larger count is cut to it.
        count: u32,
    }

    /// Emits one burst, to be drawn after this call
    /// returns. Bursts are weighed against the mod's
    /// budget: at most 1024 particles a tick across its
    /// bursts and its emitters together; past the budget
    /// the rest of the tick's bursts spawn nothing, and
    /// nothing is held over. A burst too far from the
    /// camera (past 32 blocks, as the game's own
    /// particles are), a burst on the title screen, and a
    /// burst of a type that does not spawn, all quietly
    /// spawn nothing. Malformed numbers (a non-finite
    /// position, spread or speed) refuse the whole burst,
    /// as the native line refuses them.
    emit: func(burst: burst);

    /// What an emitter is tied to.
    variant emitter-anchor {
        /// The local player.
        self-player,
        /// A drawn entity — a mob or another player — by
        /// the id `entity.entities` and the pose states
        /// use. An entity the game is not drawing (gone,
        /// too far, another dimension) anchors nothing
        /// until it is drawn again.
        entity(u32),
        /// A fixed place in the world.
        position(world-point),
    }

    /// A standing stream of particles, stepped by the
    /// game every tick until replaced or cleared.
    record emitter {
        anchor: emitter-anchor,
        /// The anchor's own frame: for `self-player` and
        /// `entity`, x is the anchor's right, y is up and
        /// z is its facing, in blocks, turned by the
        /// anchor's body yaw; for `position`, the world's
        /// axes. A wingtip is an offset of about (±1, 1,
        /// 0) on a gliding player.
        offset: world-point,
        /// The burst each spawn draws from: its particle,
        /// params, spread, speed and count, spawned at the
        /// anchor's place (its `at` is ignored).
        burst: burst,
        /// Spawns a second, 0 to 200: the game accumulates
        /// the fraction, so 7 a second is seven spawns in
        /// most seconds. Each spawn weighs its burst's
        /// count against the mod's budget, as `emit` does;
        /// an emitter starved by its own mod's bursts idles
        /// that tick rather than borrowing.
        rate: f32,
    }

    /// Replaces the mod's emitters: at most 8. They live
    /// until replaced, cleared (none), or the mod stops —
    /// a stopped mod's streams end with it, mid-flight
    /// particles living out their own lives as the game's
    /// do. Nothing here survives the world closing, either:
    /// anchors are the open world's, and a reopened world
    /// starts with no emitters until the mod declares
    /// them again.
    set-emitters: func(emitters: option<list<emitter>>);
}

/// Capability `render` (experimental), interface
/// `dynamic-light`: light sources of the mod's own in the
/// game's dynamic lights — the render-time lights a held
/// torch makes, which the game adds over the world's stored
/// light as it draws. This is a picture, like everything in
/// `render`: the world's stored light does not change, so
/// nothing spawns or grows differently, `world.get-lights`
/// does not see these sources, and no other player is sent
/// anything — every client makes its own lights from the
/// world it already sees. The game's own cap rules: at most
/// 16 sources are drawn at once, the nearest to the camera,
/// and a source lights nothing past 96 blocks or past its
/// own level in blocks — a source's reach is its level, one
/// level less per block away, through walls as through air,
/// exactly as the game's built-in dynamic lights behave.
interface dynamic-light {
    /// A point in the world, in blocks (redeclared: WIT
    /// interfaces cannot share types).
    record world-point {
        x: f64,
        y: f64,
        z: f64,
    }

    /// What a source is tied to.
    variant source-anchor {
        /// The local player, at hand height, as the game's
        /// own held-item light is placed.
        self-player,
        /// A drawn entity — a mob or another player — by
        /// the id `entity.entities` and the pose states
        /// use, at the height the game's own entity lights
        /// use. An entity the game is not drawing (gone,
        /// too far, another dimension) anchors nothing
        /// until it is drawn again.
        entity(u32),
        /// A fixed place in the world.
        position(world-point),
    }

    /// One light source of the mod's own.
    record light-source {
        anchor: source-anchor,
        /// How bright, 1 to 15 (clamped): a torch is 14, a
        /// lantern 15. 0 makes no source. Ignored when
        /// `item` is set.
        level: u8,
        /// The item whose glow this source carries:
        /// `minecraft:torch`, ... The game looks the level
        /// up in its own table — an item glows as its block
        /// does, content blocks included — and an item that
        /// does not glow, or that the game does not know,
        /// makes no source. Set this for a held item, whose
        /// brightness is the game's fact; use a bare `level`
        /// for a light that is not an item's.
        item: option<string>,
    }

    /// Replaces the mod's own sources: at most 32. They
    /// live until replaced, cleared (none), or the mod
    /// stops, and they are drawn together with the game's
    /// own dynamic lights under the same nearest-16 cap —
    /// a mod's far source yields to the game's nearer one
    /// exactly as the game's yield to each other. Nothing
    /// survives the world closing: anchors are the open
    /// world's, and a reopened world starts with no sources
    /// until the mod declares them again.
    set-sources: func(sources: option<list<light-source>>);

    /// One kind of creature that glows by being what it is,
    /// at the level the mod declares: `minecraft:blaze`
    /// at 15, ...
    record glowing-kind {
        kind: string,
        /// 1 to 15 (clamped).
        level: u8,
    }

    /// The mod's word over the game's own dynamic-light
    /// sources — the held items, dropped items and burning
    /// entities the game itself gathers. While any running
    /// mod has set a policy, the newest such policy is the
    /// gather's whole input for those sources, in place of
    /// the player's Dynamic lights extra setting (which is
    /// not changed on disk, and rules again when no policy
    /// stands). A policy says nothing about any mod's own
    /// `set-sources` lights, its author's included.
    record dynamic-light-policy {
        /// Held items shed light: the local player's,
        /// other players', mobs' and armor stands', either
        /// hand, each as bright as its block.
        held-items: bool,
        /// Dropped items shed light where they lie.
        dropped-items: bool,
        /// Entities on fire — players, mobs, dropped items,
        /// arrows — shed light as fire does (15).
        burning: bool,
        /// Creatures that glow by kind, nearest-first under
        /// the same caps: at most 32 kinds. A kind the game
        /// does not know matches nothing.
        glowing: list<glowing-kind>,
        /// Fire projectiles (fireballs, wither skulls,
        /// spectral arrows, rockets), primed TNT and lit
        /// minecarts shed light as fire does.
        projectiles: bool,
        /// Fire goes out in water: held torches and other
        /// open-flame items, burning entities and fire
        /// projectiles shed no light while under water.
        /// Lanterns and other sealed lights stay lit, as
        /// do glowing creatures and a mod's own sources.
        water-extinguishes: bool,
        /// The gathered sources' brightness, as a percent
        /// of their own levels: 100 is the levels
        /// themselves; clamped to 10..=200, and the result
        /// clamped to 15. A mod's own sources are not
        /// scaled — their levels are already its word.
        brightness: u32,
        /// How far a gathered source can be from the camera
        /// and still be drawn, in blocks: clamped to
        /// 8..=96. (A mod's own sources keep the game's 96.)
        range: u32,
        /// How many sources are drawn at once, the game's
        /// and all mods' together: clamped to 1..=16.
        max-lights: u32,
    }

    /// Sets the mod's policy over the game's own dynamic
    /// lights (see `dynamic-light-policy`), or clears it
    /// (none). Setting one replaces the mod's previous one
    /// whole. The newest policy among running mods is the
    /// one that stands; when its author stops or clears,
    /// the next newest stands, and when none stands the
    /// player's own Dynamic lights setting rules again.
    set-policy: func(policy: option<dynamic-light-policy>);
}

/// Capability `chat-decoration` (experimental: the manifest
/// needs `experimental = ["chat-decoration"]`): the game's
/// own chat, restyled as the game allows. A mod declares how
/// the chat is decorated and animated; the game does all of
/// the drawing, with its own data. A mod cannot draw over
/// the chat, add, remove or change a line, or choose what
/// appears beside one: a player's head beside their line is
/// that player's, resolved by the game from the skin it
/// holds for them, and the mod never names a player, a line
/// or a picture. Nothing here reads anything: what a mod
/// learns from chat still comes through `events.chat`, as
/// plain text, unchanged.
interface chat-decoration {
    /// How the chat's lines are decorated.
    record line-decoration {
        /// A player's own head — their skin's face, as the
        /// player list draws it — in the strip left of the
        /// first wrapped line of each chat line they wrote.
        /// Only lines the game received as that player's:
        /// system lines, disguised lines, `/me` lines,
        /// wrapped continuations and a mod's own `chat.show`
        /// lines get none. The head fades with its line, as
        /// its line does, and hides with the chat (F1).
        sender-head: bool,
    }

    /// Replaces the mod's line decoration (none clears it).
    /// It lasts until replaced, cleared, or the mod stops:
    /// a stopped mod's styling ends with it, on the next
    /// frame. When several running mods declare one, the
    /// last-loaded one's stands (the hand district's
    /// latest-writer rule); when it stops, an earlier
    /// declaration stands again.
    set-line-decoration: func(decoration: option<line-decoration>);

    /// How the chat box itself moves. Every duration is
    /// milliseconds, 0 to 1000 (a larger value is cut to
    /// 1000); 0 is off. The game eases each animation with
    /// its own curve and always lands exactly where vanilla
    /// puts things: these numbers change how the chat
    /// arrives, never where it rests.
    record chat-animation {
        /// A new message eases the chat up into place over
        /// this long, the stack starting one line lower.
        message-ms: u32,
        /// The new message also fades in over `message-ms`.
        /// Off: it slides at its line's own opacity.
        fade-in: bool,
        /// Opening the chat slides the input field up from
        /// the bottom of the screen over this long.
        input-ms: u32,
        /// Hides the coloured bar at the left of a message's
        /// lines (the indicator the game's trust tags draw).
        /// The bar only: a modified message keeps the icon
        /// after its lines, and hovering the bar's place
        /// still shows the tag's tooltip.
        hide-indicator: bool,
    }

    /// Replaces the mod's chat animation (none clears it),
    /// with the same lifetime and the same latest-writer
    /// rule as `set-line-decoration` — the two records are
    /// independent: one mod's heads and another's animation
    /// stand together.
    set-animation: func(animation: option<chat-animation>);
}

/// What the game calls for sounds (API 15). Only the first mod in
/// load order with this export is asked; mods built before API 15
/// have no such export and simply never hear sounds. The call must
/// be fast: it runs on the game thread at the moment a sound starts
/// (and every 10 ticks while a ticking sound plays).
interface audio-events {
    /// A position in the world.
    record sound-position {
        x: f64,
        y: f64,
        z: f64,
    }
    /// A world sound about to play. Music and relative (UI) sounds
    /// are never offered.
    record sound-query {
        /// The registry sound event id (for example
        /// `block.stone.break`, without a namespace).
        event: string,
        /// The sound's category (vanilla `SoundSource` order):
        /// 0 master, 1 music, 2 record, 3 weather, 4 block,
        /// 5 hostile, 6 neutral, 7 player, 8 ambient, 9 voice, 10 ui.
        category: u32,
        /// Where it plays from.
        position: sound-position,
        /// It loops (ambience, minecarts) rather than playing once.
        looping: bool,
        /// The sound's own volume, before distance falloff.
        volume: f32,
        /// The sound's own pitch multiplier.
        pitch: f32,
    }
    /// What the mod returns: the game applies these on top of its
    /// own volume. A mod can only ever quieten a sound.
    record sound-adjustment {
        /// Volume multiplier, clamped to 0.0..=1.0.
        gain: f32,
        /// Muffle amount 0.0..=1.0 (a lowpass on the sound).
        lowpass: f32,
        /// Reverb send 0.0..=1.0.
        reverb: f32,
    }
    /// A world sound is starting (or a ticking sound is refreshed).
    sound: func(query: sound-query) -> sound-adjustment;
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    record registration {
        /// Chat commands, without the slash. A name vanilla already uses is
        /// refused (vanilla's command runs).
        commands: list<string>,
        /// Call `tick` every game tick (20 per second while playing).
        tick: bool,
        /// Call `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// Call `chat` for each chat line the player receives.
        chat: bool,
    }
    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    /// Each game tick while in a world, with the game's tick counter.
    tick: func(tick: u64);
    /// Each rendered frame, with the seconds since the last one.
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    /// Each chat line the player receives, as plain text.
    chat: func(text: string);
}

/// Capability `recipes` (experimental): the recipes and items the game
/// knows, for recipe viewers. In single player and on Horizon's servers
/// they are the world's; on any other server they are vanilla 26.3's (a
/// client is sent no others), while `known` follows that server's book.
interface recipes {
    /// An item of `items`, by its index there, with a count and the
    /// components it has beyond the item's own, in vanilla's item syntax
    /// (`[potion_contents={potion:"minecraft:swiftness"}]`), or "".
    record stack {
        item: u32,
        count: u32,
        components: string,
    }
    /// The station a recipe is made at.
    enum kind {
        crafting-shaped,
        crafting-shapeless,
        smelting,
        blasting,
        smoking,
        campfire,
        stonecutting,
        smithing,
        brewing,
    }
    record recipe {
        /// `minecraft:oak_planks`.
        id: string,
        kind: kind,
        /// The recipe book's tab (`crafting_building_blocks`,
        /// `furnace_food`), or "".
        category: string,
        /// Recipes the book shows on one button share a group, or "".
        group: string,
        /// A shaped recipe's grid: `slots` holds its cells row by row.
        /// 0 for the other kinds.
        width: u32,
        height: u32,
        /// Each slot's stacks, any one of which fits; an empty list is an
        /// empty cell. Cooking and stonecutting: the input. Smithing: the
        /// template, the base, the addition. Brewing: the bottle, the
        /// reagent.
        slots: list<list<stack>>,
        /// What it makes; several when that varies (a trim on any armour).
        results: list<stack>,
        /// Cooking: game ticks and experience; 0 for the other kinds.
        cooking-time: u32,
        experience: f32,
        /// The recipe book's id for it (one per way the book shows it), as
        /// `known` lists them; -1 for the kinds the book doesn't show
        /// (campfire, stonecutting, smithing, brewing).
        book-id: s32,
    }
    record item {
        /// `minecraft:diamond`, `<mod>:<path>`.
        id: string,
        /// In the player's language.
        name: string,
        /// Its item tags, without the `#`.
        tags: list<string>,
    }
    /// Every item, in the registry's order: `stack.item` indexes this list.
    items: func() -> list<item>;
    /// Every recipe: the book's in its order, then campfire, stonecutting,
    /// smithing and brewing. They don't change while a world is open.
    all: func() -> list<recipe>;
    /// The `book-id`s of the recipes the player's recipe book holds now.
    known: func() -> list<s32>;
    /// Places a recipe in the open screen's grid as a click in the recipe
    /// book does (`ServerboundPlaceRecipePacket`): the inventory's grid or
    /// a crafting table. `all` places as many as the items allow, as with
    /// Shift. Refused while no such screen is open, for a recipe the
    /// player's book doesn't hold and for one that can't be placed; one
    /// missing items shows as a ghost in the grid, as in the book.
    place: func(book-id: s32, all: bool) -> result<_, string>;
    /// Creative mode only: gives the player the stack, as taking it from
    /// the creative inventory does (`ServerboundSetCreativeModeSlot`): the
    /// selected slot first, then the hotbar, then the inventory. The count
    /// is cut to one stack of the item (64, 16 or 1).
    give: func(stack: stack) -> result<_, string>;
}

/// Capability `ui` (experimental): a recipe viewer's panel beside the
/// game's inventory and container screens (not the creative inventory), on
/// the right of the screen. The game draws it with its own widgets and
/// slots, pages it and keeps its search box; the mod says what it holds.
/// The first loaded mod with a panel shows.
interface browser {
    /// An item to show: its id, a count (1 draws none) and its components
    /// beyond the item's own, in vanilla's item syntax, or "".
    record stack {
        item: string,
        count: u32,
        components: string,
    }
    /// A click on an item of the panel, by its index in `set-items`'s list.
    record click {
        index: u32,
        right: bool,
    }
    /// A key the mod registered (`input.register-key`) went down while the
    /// pointer was on an item: a slot of the screen's, or the panel's.
    record item-key {
        key: string,
        stack: stack,
    }
    /// A click on a slot of a recipe the panel shows (`set-recipes`).
    record slot-click {
        /// The recipe's index in `set-recipes`'s list and the slot's in
        /// it; the results come after the slots.
        recipe: u32,
        slot: u32,
        /// The stack the slot showed at that moment.
        stack: stack,
        right: bool,
    }
    variant event {
        clicked(click),
        /// The search box's text, each time the player changes it.
        search(string),
        key(item-key),
        slot-clicked(slot-click),
        /// The action button of the recipe at this index in
        /// `set-recipes`'s list.
        action(u32),
        /// The player turned the recipes' page (`set-recipes`): the index
        /// of the first recipe now shown.
        page(u32),
        /// The back button of `set-recipes`.
        back,
        /// The player picked the tab at this index of `set-recipes`' tabs.
        tab(u32),
    }
    /// How the game lays out a recipe of `set-recipes`.
    enum layout {
        /// A crafting grid of `width` x `height` slots, an arrow and the
        /// result.
        grid,
        /// One input over a flame, an arrow and the result (furnaces,
        /// smokers, campfires).
        cooking,
        /// One input, an arrow and the result (the stonecutter).
        single,
        /// Template, base and addition, an arrow and the result.
        smithing,
        /// A potion and an ingredient, an arrow and the result.
        brewing,
    }
    /// A recipe to show. Each slot, and the result, cycles through its
    /// stacks, one a second; an empty slot shows nothing.
    record recipe-view {
        layout: layout,
        /// The grid's size (`grid` only), at most 3 x 3.
        width: u32,
        height: u32,
        slots: list<list<stack>>,
        results: list<stack>,
        /// A short line under the recipe (a cooking time), or "".
        note: string,
        /// The action button beside it: none, enabled, or shown greyed.
        action: option<bool>,
    }
    /// The panel's items, at most 8192 (an empty list hides the panel).
    set-items: func(items: list<stack>);
    /// Shows these recipes in the panel instead of its items, as many as
    /// fit a page, under `title` and a back button, with a row of `tabs`
    /// (each an icon; `tab` is the selected one) between them; an empty
    /// list of recipes shows the items again. At most 256 recipes and 16
    /// tabs.
    set-recipes: func(title: string, tabs: list<stack>, tab: u32, recipes: list<recipe-view>);
    /// What the player did on the panel since the last poll, at most 256
    /// kept.
    poll: func() -> list<event>;
}

/// Capability `players`, server mods only (manifest `api = "0.3"`,
/// experimental): the players on the server, and messages to them.
interface players {
    enum game-mode {
        survival,
        creative,
        adventure,
        spectator,
    }
    record player {
        /// The player's UUID, `xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx`.
        id: string,
        name: string,
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
        game-mode: game-mode,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
    }
    /// The players online, in the order they joined.
    online: func() -> list<player>;
    /// A system message to one player, after the mod's name; false when no
    /// player with that id is online. Up to 8 messages per call.
    tell: func(player: string, text: string) -> bool;
    /// A system message to every player and the server's log, after the
    /// mod's name. Counts toward the same 8 per call.
    broadcast: func(text: string);
}

/// Capability `world` (manifest `api = "0.3"`, experimental, for server
/// mods; read-only for client mods): the blocks of the loaded chunks, and
/// changes to them through the server's own block updates. A client mod
/// reads only the dimension the player is in, and only chunks the game has
/// loaded; in v1 only in singleplayer, where the world is the player's own.
/// `set-blocks` from a client mod is refused.
interface %world {
    record block-change {
        x: s32,
        y: s32,
        z: s32,
        /// `minecraft:oak_log[axis=y]`; properties left out take the block's
        /// defaults, `minecraft:stone` alone is the default state.
        state: string,
    }
    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }
    record block-result {
        x: s32,
        y: s32,
        z: s32,
        /// None where no chunk is loaded there.
        state: option<string>,
    }
    /// The block state at a position in a dimension (`minecraft:overworld`,
    /// ...), as `minecraft:oak_log[axis=y]`, as of this call: none where the
    /// server has no chunk loaded there.
    get-block: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// The biome at a position (`minecraft:plains`, ...), as the server
    /// stores it (one per 4 x 4 x 4 cell): none where no chunk is loaded.
    get-biome: func(dimension: string, x: s32, y: s32, z: s32) -> option<string>;
    /// The block states at `positions`, in the same order, as of this call.
    /// At most 4096 positions per call; a call over the cap returns no
    /// results. None per position where no chunk is loaded there. This is
    /// the only bulk read: do not loop get-block.
    get-blocks: func(dimension: string, positions: list<block-pos>) -> list<block-result>;
    record light-value {
        /// Light from blocks (torches, lava, glowstone, ...), 0 to 15.
        block: u8,
        /// Light from the sky, as stored, 0 to 15; 0 in dimensions
        /// without skylight (the Nether).
        sky: u8,
    }
    record light-result {
        x: s32,
        y: s32,
        z: s32,
        /// None where no chunk is loaded there, where the chunk's
        /// light has not been computed yet, or outside the column's
        /// build range. Never a guessed value: an unlit chunk would
        /// read as full sky light, so it reads as None instead.
        light: option<light-value>,
    }
    /// The light at `positions`, in the same order, as of the last
    /// completed light job. At most 4096 positions per call; a call
    /// over the cap returns no results. None per position where no
    /// chunk is loaded there or its light is not computed yet. This
    /// is the only bulk light read: do not loop a single read.
    /// Tick-only, like `get-blocks`: a frame, chat or command hook
    /// reads None.
    get-lights: func(dimension: string, positions: list<block-pos>) -> list<light-result>;
    /// Sets blocks as `/setblock` does: the old block entity removed,
    /// neighbours and shapes updated, light, and every player told. Every
    /// state is checked now (an error queues nothing); the changes are made
    /// in order after this call returns, before that dimension's next tick;
    /// one in a chunk not loaded then is skipped. At most 4096 per call.
    set-blocks: func(dimension: string, blocks: list<block-change>) -> result<_, string>;
}

/// Capability `inventory` (manifest `api = "0.1"`, experimental): the
/// player's own inventory and the contents of a container the player
/// currently has open. Read-only: there is no function here that moves a
/// stack, clicks a slot or gives an item. Nothing here can see a container
/// that is not open, another player's inventory, or a block entity in the
/// world. The snapshot is copied once per tick, so a mod reads the
/// inventory as of the last tick, not as of its call.
interface %inventory {
    /// One slot's stack, as the game holds it.
    record inv-stack {
        /// The slot, in the client's internal numbering: 0-8 hotbar,
        /// 9-35 main inventory, 100-108 crafting grid, 200 crafting
        /// result, 300+ open container, 500-503 armour (head, chest,
        /// legs, feet), 504 offhand.
        slot: u32,
        /// `minecraft:diamond_sword`, ...
        id: string,
        count: u32,
        /// Durability damage taken; 0 for undamageable items.
        damage: u32,
        /// The item's maximum damage (0: undamageable). Remaining
        /// durability is `max-damage - damage`.
        max-damage: u32,
        /// Components beyond id/count/damage, in vanilla item syntax
        /// (`[enchantments={...}]`), or "" when default. Same syntax
        /// as `recipes.stack.components`.
        components: string,
    }
    /// The player's own inventory, armour, offhand, crafting grid and
    /// carried stack, as of this tick. Empty slots are omitted.
    /// `selected` is the hotbar slot, 0-8.
    record player-inventory {
        selected: u32,
        /// The player's saturation, 0 to 20, as the hunger bar's hidden
        /// half: it lives here, not on `game.player`, so mods built
        /// against that record keep their shape. Exhaustion is not on
        /// the client at all and cannot be exposed.
        saturation: f32,
        slots: list<inv-stack>,
        /// The cursor stack, if the player is carrying one. The cursor
        /// has no slot; its `slot` is 0 and means nothing.
        carried: option<inv-stack>,
    }
    /// A container the player has open, if any.
    record container {
        /// `minecraft:chest`, `minecraft:furnace`, `minecraft:crafting`,
        /// `inventory`, ... — the menu type the server opened.
        kind: string,
        /// The container's slots, in menu order. Slots are numbered as
        /// `inv-stack.slot`: the container's own slots (300+ for a
        /// chest-like menu, the workstation's input/result slots), never
        /// the player's inventory slots, which `inventory()` already
        /// covers.
        slots: list<inv-stack>,
        /// The container's numeric data slots, if it has any, in the
        /// order the screen shows them (furnace burn/cook progress,
        /// enchanting costs, seed and clue levels, beacon levels and
        /// powers, loom/stonecutter selection, anvil cost, lectern
        /// page). Empty for plain chests. See `docs/mods.md` for the
        /// layout of each kind.
        data: list<s32>,
    }
    /// The player's own inventory, as of this tick.
    inventory: func() -> player-inventory;
    /// The open container, if a container screen is open; none otherwise.
    /// The slots are cleared the tick the menu closes: a mod can never
    /// read a container after closing it.
    open-container: func() -> option<container>;
}

/// Capability `entity` (manifest `api = "0.1"`, experimental): the living
/// mobs around the player and the entity under the crosshair. Read-only:
/// nothing here can damage, move, spawn, ride or interact with an entity,
/// and it cannot see another player's inventory or health. The snapshot is
/// copied once per tick, so a mod reads the entities as of the last tick,
/// not as of its call.
interface %entity {
    /// One living mob, as the game holds it this tick.
    record entity {
        /// The entity id the server tracks it by.
        id: u32,
        /// `minecraft:zombie`, `minecraft:cow`, `minecraft:player`, ...
        kind: string,
        /// The name as the game shows it: the custom name when set, else
        /// the type's translated display name (a player's profile name
        /// for `minecraft:player`).
        name: string,
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Blocks per second.
        vx: f64,
        vy: f64,
        vz: f64,
        /// Degrees, movement facing.
        yaw: f32,
        /// Hit points as vanilla counts them, or none where the client
        /// cannot vouch for it (multiplayer in v1). `max-health` is the
        /// type's maximum.
        health: option<f32>,
        max-health: f32,
        /// Hitbox size, in blocks (from the type).
        width: f32,
        height: f32,
        /// The mob stands on a block.
        on-ground: bool,
        /// The plain-text custom name, if the mob has one.
        custom-name: option<string>,
        /// A baby variant (animals, zombies, piglins...).
        baby: bool,
    }
    /// The entity under the crosshair, if any.
    record target {
        entity: entity,
        /// Blocks from the eye to the hit point.
        distance: f32,
    }
    /// The living mobs within 128 blocks, nearest first, at most 256.
    /// Other players are not listed. Empty on the title screen and, in
    /// v1, in multiplayer.
    entities: func() -> list<entity>;
    /// The nearest pickable living mob along the player's view within
    /// `distance` blocks (at most 128), before any block: a wall between
    /// the two hides the mob. None when nothing is hit, and on the title
    /// screen. Works in singleplayer and multiplayer.
    targeted: func(distance: f32) -> option<target>;
}

/// What the server calls in a server mod (manifest `api = "0.3"`,
/// experimental). Only the hooks `init` asks for are ever called. The player
/// in each event is as the server saw them when it happened.
interface server-events {
    use players.{player};

    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }
    /// What an argument of a command takes. The server sends each command
    /// and its arguments to players' games, whose chat box completes and
    /// colours them as vanilla's; the server parses them before the mod's
    /// `command` hook gets their values.
    variant argument-kind {
        /// One word: letters, digits and `_ - . +`.
        word,
        /// The rest of the line, spaces included: only last.
        text,
        /// A whole number, within the bounds given.
        integer(tuple<option<s32>, option<s32>>),
        /// A number with or without decimals.
        number,
        /// `true` or `false`.
        boolean,
        /// One online player: a name, or `@s` or `@p` (whoever typed it,
        /// as vanilla picks for a player).
        player,
        /// A block position: three whole numbers, each one also `~` or
        /// `~n`, relative to whoever typed it.
        block-pos,
    }
    record argument {
        /// Shown in the chat box's hint (`<height>`) and the key of its value.
        name: string,
        kind: argument-kind,
        /// Optional arguments come after every required one.
        optional: bool,
    }
    record server-command {
        /// Without the slash. A name vanilla already uses is refused
        /// (vanilla's command runs).
        name: string,
        /// In order; none: the command takes nothing after its name. Free
        /// text is one optional `text` argument.
        arguments: list<argument>,
    }
    /// An argument's value, parsed as its kind says.
    variant argument-value {
        word(string),
        text(string),
        integer(s32),
        number(f64),
        boolean(bool),
        player(player),
        block-pos(block-pos),
    }
    record registration {
        /// Commands players may type.
        commands: list<server-command>,
        /// Call `tick` every server tick (20 per second).
        tick: bool,
        /// Call `player-joined` and `player-left`.
        joins: bool,
        /// Call `chat` for each chat message a player sends.
        chat: bool,
        /// Call `block-broken` and `block-placed`.
        blocks: bool,
    }
    /// Once, after loading. An error keeps the mod off and is logged.
    init: func() -> result<registration, string>;
    /// Each server tick, with the server's tick counter.
    tick: func(tick: u64);
    /// A player joined the server; they are in `players.online` already.
    player-joined: func(player: player);
    /// A player left the server; they are no longer in `players.online`.
    player-left: func(player: player);
    /// A chat message a player sent, as plain text.
    chat: func(player: player, text: string);
    /// `/name args` typed by `player`: ok(some(text)) is their feedback,
    /// err(text) their error in red. `values` holds each argument given, by
    /// name, in order (an optional one left out isn't there); a line that
    /// doesn't parse never reaches the mod: the player gets vanilla's error.
    command: func(player: player, name: string, args: string, values: list<tuple<string, argument-value>>) -> result<option<string>, string>;
    /// A player broke the block at `pos` in their dimension: `state` is what
    /// was there, as `minecraft:oak_log[axis=y]`.
    block-broken: func(player: player, pos: block-pos, state: string);
    /// A player placed `state` at `pos` in their dimension.
    block-placed: func(player: player, pos: block-pos, state: string);
}

/// A client mod: runs in the player's game.
world horizon-mod {
    import log;
    import game;
    import chat;
    import hud;
    import storage;
    import command;
    /// Read-only: `get-block`, `get-biome` and `get-blocks` only, in
    /// singleplayer in v1; `set-blocks` is refused.
    import %world;
    /// Read-only: the player's own inventory and the open container's
    /// contents, as of this tick; nothing here writes.
    import %inventory;
    /// Read-only: the living mobs around the player and the entity under
    /// the crosshair, as of this tick; nothing here writes.
    import %entity;
    export events;
}

/// A server mod (manifest `side = "server"`, `api = "0.3"`, experimental):
/// runs where the world is simulated, on the dedicated server, a LAN host
/// and single player's own server.
world horizon-server-mod {
    import log;
    import storage;
    import players;
    import %world;
    export server-events;
}

/// A mod with widgets (capability `ui`): the SDK builds every mod against
/// this world. Mods built for `horizon-mod` alone (no `ui-events` export)
/// still load and simply hear nothing of their widgets.
world horizon-ui-mod {
    include horizon-mod;
    import ui;
    import render;
    import input;
    import recipes;
    import browser;
    import audio;
    import hand;
    import entity-pose;
    import item-model;
    import particles;
    import dynamic-light;
    import actions;
    import screen;
    import inventory-actions;
    import %map;
    import chat-decoration;
    export ui-events;
    export audio-events;
}

/// The game's side of `horizon-ui-mod` beyond `horizon-mod`.
world ui-host {
    import ui;
    export ui-events;
}

/// The game's side of capability `audio` (API 15) beyond
/// `horizon-mod`: a second world, so mods built before it (no
/// `audio-events` export) still instantiate as `horizon-mod` and
/// simply never hear sounds.
world audio-host {
    import audio;
    export audio-events;
}

/// The game's side of capability `render` (imports only). API 16's
/// `hand` rides along: it is a render extension, checked against
/// the `render` capability, not one of its own. API 20's
/// `entity-pose` rides along the same way. API 21's `actions` is
/// hosted here too — the frame/tick-adjacent client surfaces live
/// in this world — but it is its own capability, not render's:
/// acting is not presentation. API 22's `screen` likewise: its
/// reads are presentation, but `select-trade` spends items, so
/// the interface is its own capability with a consent line that
/// names both halves. API 23's `item-model` rides along with the
/// hand and the poses: its writes are display only — a stack's
/// picture, marks on its slots, dropped items' lie — so it is
/// render's, with no consent line of its own. API 24's
/// `inventory-actions` is hosted here too, as the actions and
/// the screens are, and is its own capability, not
/// `inventory`'s: reading an inventory and moving its stacks
/// are different consents, and a shipped `inventory` mod's
/// line said only the reading. API 25's `map` is hosted here
/// too, and is its own capability as well: its heart is a
/// survey — the game's tiles of the ground around the player,
/// and where they died and came back — not drawing, though
/// its full-screen map and its own minimap ride along.
/// API 26's `particles` rides along with the hand, the poses
/// and the item models: a burst is a picture in the world,
/// drawn by the game's own engine — nothing spent, moved or
/// read — so it is render's, with no consent line of its own.
/// API 27's `chat-decoration` is hosted here too, as the
/// frame-adjacent client surfaces are, and is its own
/// capability, not `chat`'s or `render`'s: it supplies no
/// content of its own — it asks the game to restyle the
/// game's own chat — and one of its toggles is trust-adjacent,
/// so the restyle gets a consent line of its own.
/// API 28's `dynamic-light` rides along with the particles:
/// a mod's own light in the game's dynamic lights, and its
/// policy over the game's own gather, are a picture in the
/// world — nothing spent, moved, read or sent, and the
/// player's setting is never written — so it is render's,
/// with no consent line of its own.
world render-host {
    import render;
    import input;
    import hand;
    import entity-pose;
    import item-model;
    import particles;
    import dynamic-light;
    import actions;
    import screen;
    import inventory-actions;
    import %map;
    import chat-decoration;
}

/// The game's side of capability `recipes` (imports only).
world recipes-host {
    import recipes;
    import browser;
}
